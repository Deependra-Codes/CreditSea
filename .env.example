# ─── API (apps/api/.env) ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# MongoDB Atlas. Create a free M0 cluster, then Database Access → add a user,
# and Network Access → Add Current IP (skipping this causes connection timeouts).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lms?retryWrites=true&w=majority

# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

WEB_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads

# ─── Web (apps/web/.env.local) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
